{# Esta plantilla hereda de base.html.twig #}
{% extends "base.html.twig" %}

{# 
    Sobreescribimos el titulo de la pagina, usamos la variable projectName,
    la cualvendra desde el controlador  
#}
{% block title %}{{projectName}}{% endblock %}

{# Inserto el cuerpo de la pagina de incio#}
{% block body %}
    <section class="hero">
        <p class="eyebrow">IFCT092PO . Proyecto del curso</p>
        {# projectName debe venir desde el controlador #}
        <h1>{{ projectName }}</h1>
        {# message debe venir desde el controlador #}
        <p>{{ message }}</p>
        {# Generamos el enlace a incidencias usando el nombre de Symfony de la ruta #}
        <p><a href="{{path('app_ticket_index')}}">Ver Incidencias</a></p>
    </section>
{% endblock %}
